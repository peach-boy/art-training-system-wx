page {
  background: #f5f6fa;
  color: #333;
  font-size: 28rpx;
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #ff6b35 !important;
  color: #fff !important;
  border: none !important;
  border-radius: 12rpx !important;
}

.btn-ghost {
  background: #fff !important;
  color: #666 !important;
  border: 1rpx solid #e8e8e8 !important;
  border-radius: 12rpx !important;
}

.text-muted {
  color: #999;
  font-size: 24rpx;
}

.text-danger {
  color: #ff4d4f;
}

.tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #f0f0f0;
  color: #666;
}

.tag-orange { background: #fff7e6; color: #fa8c16; }
.tag-blue { background: #e6f4ff; color: #1677ff; }
.tag-purple { background: #f9f0ff; color: #722ed1; }
.tag-cyan { background: #e6fffb; color: #13c2c2; }

.empty {
  text-align: center;
  padding: 80rpx 24rpx;
  color: #999;
}

.field-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.field-block {
  margin-bottom: 24rpx;
}

.picker-value {
  background: #fafafa;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  color: #333;
}

.picker-value.placeholder {
  color: #bbb;
}
