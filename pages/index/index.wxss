.page-home {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.hero {
  padding: 48rpx 32rpx 56rpx;
  background: linear-gradient(145deg, #1a1a2e 0%, #243b5e 55%, #2d4a73 100%);
  border-radius: 0 0 40rpx 40rpx;
  color: #fff;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hero-greet {
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
}

.hero-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
}

.page-body {
  padding: 0 24rpx;
  margin-top: -28rpx;
}

.month-card {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 36rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(26, 26, 46, 0.08);
  margin-bottom: 24rpx;
}

.month-label {
  flex: 1;
  font-size: 28rpx;
  color: #666;
}

.month-num {
  font-size: 64rpx;
  font-weight: 700;
  color: #ff6b35;
  line-height: 1;
}

.month-unit {
  font-size: 26rpx;
  color: #999;
}

.action-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, #ff8f5a 0%, #ff6b35 100%);
  border-radius: 24rpx;
  color: #fff;
  box-shadow: 0 16rpx 40rpx rgba(255, 107, 53, 0.28);
  margin-bottom: 24rpx;
}

.action-card-left {
  flex: 1;
}

.action-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.action-desc {
  font-size: 24rpx;
  opacity: 0.92;
  line-height: 1.5;
}

.action-arrow {
  font-size: 48rpx;
  opacity: 0.85;
}

.stats-row {
  display: flex;
  gap: 20rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 46, 0.05);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.stat-num-text {
  font-size: 32rpx;
  color: #ff6b35;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}
