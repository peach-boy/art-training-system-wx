.page-profile {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.profile-hero {
  padding: 56rpx 32rpx 64rpx;
  background: linear-gradient(145deg, #1a1a2e 0%, #243b5e 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.profile-name {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.profile-meta {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.72);
}

.profile-body {
  padding: 0 24rpx;
  margin-top: -28rpx;
}

.profile-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 26, 46, 0.06);
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #333;
}

.store-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #f5f6fa;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #333;
}

.picker-arrow {
  color: #ccc;
  font-size: 36rpx;
}

.tips {
  margin-top: 16rpx;
  font-size: 24rpx;
}

.logout-btn {
  margin-bottom: 32rpx;
  height: 88rpx !important;
  line-height: 88rpx !important;
  border-radius: 44rpx !important;
}

.beian {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  padding-bottom: 16rpx;
}
