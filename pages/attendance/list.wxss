.page-list {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.list-header {
  background: #fff;
  padding: 24rpx 24rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 20rpx;
}

.filter-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.filter-chip {
  padding: 12rpx 20rpx;
  background: #f5f6fa;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #666;
}

.filter-sep {
  color: #ccc;
  font-size: 24rpx;
}

.filter-actions {
  display: flex;
  gap: 12rpx;
  margin-left: auto;
}

.filter-btn {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 24rpx;
}

.filter-btn.ghost {
  background: #fff;
  color: #666;
  border: 1rpx solid #e8e8e8;
}

.record-list {
  padding: 16rpx 24rpx 0;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(26, 26, 46, 0.04);
}

.record-thumb {
  flex-shrink: 0;
}

.record-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: #f5f6fa;
}

.record-img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ccc;
  font-size: 28rpx;
}

.record-content {
  flex: 1;
  min-width: 0;
}

.record-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.record-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.record-sub {
  font-size: 24rpx;
  color: #666;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-chevron {
  color: #ccc;
  font-size: 36rpx;
}

.load-more {
  padding: 8rpx 24rpx 24rpx;
}
