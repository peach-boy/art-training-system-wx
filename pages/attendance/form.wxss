.page-form {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.form-section {
  padding: 24rpx 24rpx 0;
}

.section-head {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
  padding-left: 8rpx;
}

.form-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(26, 26, 46, 0.04);
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.cell:last-child {
  border-bottom: none;
}

.cell-label {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #333;
}

.cell-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333;
}

.cell-value.placeholder {
  color: #bbb;
}

.cell-value.arrow::after {
  content: ' ›';
  color: #ccc;
}

.field-block.inner {
  padding: 0 24rpx 24rpx;
}

.scope-row {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 16rpx;
}

.scope-chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
}

.scope-chip.active {
  color: #ff6b35;
  background: #fff4ef;
  font-weight: 500;
}

.search-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  padding: 0 24rpx 16rpx;
}

.search-input {
  flex: 1;
}

.search-btn {
  flex-shrink: 0;
}

.field-block {
  padding-top: 24rpx;
}

.field-label {
  padding: 0 24rpx 12rpx;
}

.input,
.textarea,
.cell-value {
  background: #fafafa;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.field-block .cell-value {
  margin: 0 24rpx 16rpx;
}

.textarea {
  width: calc(100% - 48rpx);
  min-height: 160rpx;
  margin: 0 24rpx 24rpx;
  box-sizing: border-box;
}

.custom-name {
  margin: 12rpx 24rpx 24rpx;
}

.tips {
  padding: 0 24rpx 24rpx;
  font-size: 24rpx;
}

.upload-area {
  padding: 24rpx;
  position: relative;
}

.upload-placeholder {
  height: 280rpx;
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #999;
  font-size: 28rpx;
  background: #fafafa;
}

.upload-plus {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff4ef;
  color: #ff6b35;
  font-size: 48rpx;
  line-height: 68rpx;
  text-align: center;
}

.upload-hint {
  font-size: 22rpx;
  color: #bbb;
}

.upload-preview-wrap {
  position: relative;
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-remove {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  text-align: center;
  line-height: 44rpx;
  font-size: 36rpx;
}

.upload-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.72);
  color: #666;
  font-size: 28rpx;
}

.form-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #eee;
  box-shadow: 0 -8rpx 24rpx rgba(26, 26, 46, 0.06);
}

.footer-btn {
  width: 100% !important;
  height: 88rpx !important;
  line-height: 88rpx !important;
  border-radius: 44rpx !important;
  font-size: 32rpx !important;
}
