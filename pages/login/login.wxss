.login-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
  padding: 120rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  margin-bottom: 48rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 28rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
}

.title {
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
}

.subtitle {
  color: rgba(255, 255, 255, 0.65);
  font-size: 26rpx;
  margin-top: 12rpx;
}

.login-card {
  padding: 32rpx;
}

.input {
  background: #fafafa;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.captcha-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.captcha-input {
  flex: 1;
}

.captcha-img,
.captcha-placeholder {
  width: 200rpx;
  height: 80rpx;
  border-radius: 8rpx;
  border: 1rpx solid #eee;
  background: #fafafa;
}

.captcha-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
}

.login-btn {
  margin-top: 16rpx;
}

.hint {
  text-align: center;
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #bbb;
}

.beian {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
}
