<view class="login-page">
  <view class="login-header">
    <view class="logo">A</view>
    <view class="title">ART 课时录入</view>
    <view class="subtitle">教师登录 · 录入学员课时</view>
  </view>

  <view class="login-card card">
    <view class="field-block">
      <view class="field-label">手机号</view>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="field-block">
      <view class="field-label">密码</view>
      <input class="input" password placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput" bindconfirm="handleLogin" />
    </view>

    <button class="btn-primary login-btn" loading="{{loading}}" bindtap="handleLogin">登 录</button>
    <view class="hint">各位老师使用手机号登录，仅可录入归属学员课时</view>
  </view>

  <view class="beian">
    <navigator url="" hover-class="none" bindtap="openBeian">{{icpNumber}}</navigator>
  </view>
</view>
