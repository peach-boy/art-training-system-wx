<view class="tab-bar">
  <view class="tab-bar-inner">
    <view
      class="tab-item {{active === 'home' ? 'active' : ''}}"
      bindtap="onSwitch"
      data-path="/pages/index/index"
      data-key="home"
    >
      <view class="tab-icon tab-icon-home"></view>
      <text class="tab-text">首页</text>
    </view>
    <view class="tab-item tab-item-add" bindtap="onAdd">
      <view class="tab-add-btn">+</view>
      <text class="tab-text tab-text-add">录入</text>
    </view>
    <view
      class="tab-item {{active === 'records' ? 'active' : ''}}"
      bindtap="onSwitch"
      data-path="/pages/attendance/list"
      data-key="records"
    >
      <view class="tab-icon tab-icon-records"></view>
      <text class="tab-text">记录</text>
    </view>
  </view>
  <view class="tab-safe"></view>
</view>
