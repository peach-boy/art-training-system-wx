.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #eee;
  box-shadow: 0 -8rpx 32rpx rgba(26, 26, 46, 0.06);
  backdrop-filter: blur(12px);
}

.tab-bar-inner {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 108rpx;
  padding: 0 12rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #999;
}

.tab-item.active {
  color: #ff6b35;
}

.tab-text {
  font-size: 22rpx;
  line-height: 1;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

.tab-icon-home::before,
.tab-icon-home::after,
.tab-icon-records::before,
.tab-icon-records::after,
.tab-icon-profile::before,
.tab-icon-profile::after {
  content: '';
  position: absolute;
  box-sizing: border-box;
}

.tab-icon-home::before {
  left: 8rpx;
  top: 8rpx;
  width: 28rpx;
  height: 22rpx;
  border: 3rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
}

.tab-icon-home::after {
  left: 14rpx;
  top: 2rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
  transform: rotate(45deg);
}

.tab-icon-records::before {
  left: 10rpx;
  top: 6rpx;
  width: 24rpx;
  height: 30rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
}

.tab-icon-records::after {
  left: 16rpx;
  top: 14rpx;
  width: 12rpx;
  height: 3rpx;
  background: currentColor;
  box-shadow: 0 8rpx 0 currentColor, 0 16rpx 0 currentColor;
}

.tab-icon-profile::before {
  left: 14rpx;
  top: 4rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.tab-icon-profile::after {
  left: 8rpx;
  top: 24rpx;
  width: 28rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 14rpx 14rpx 0 0;
}

.tab-item-add {
  margin-top: -28rpx;
}

.tab-add-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8f5a 0%, #ff6b35 100%);
  color: #fff;
  font-size: 56rpx;
  line-height: 92rpx;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(255, 107, 53, 0.45);
}

.tab-text-add {
  margin-top: 8rpx;
  color: #ff6b35;
  font-weight: 500;
}

.tab-safe {
  height: env(safe-area-inset-bottom);
}
